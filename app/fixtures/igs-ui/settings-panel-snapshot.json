{
  "requiredSelectors": [
    "#igs-unified-settings",
    ".igs-settings-shell",
    ".igs-settings-head",
    ".igs-settings-theme-toggle",
    ".igs-settings-tabs",
    ".igs-settings-body",
    ".igs-segmented",
    ".igs-scene-settings-subtabs",
    ".igs-reader-subtabs",
    ".igs-source-filter",
    ".igs-settings-preview"
  ],
  "tabs": [
    {
      "id": "basic",
      "label": "基础",
      "requiredPaths": [
        "bridge.openMode",
        "bridge.showToasts",
        "bridge.settingsTheme",
        "bridge.debug"
      ]
    },
    {
      "id": "regex",
      "label": "正文替换",
      "requiredPaths": [
        "bridge.sourceFilter.enabled",
        "bridge.sourceFilter.textIncludeTags",
        "bridge.sourceFilter.textExcludeTags",
        "bridge.sourceFilter.imageIncludeTags",
        "bridge.virtualRegex.enabled",
        "bridge.virtualRegex.pattern",
        "bridge.virtualRegex.flags",
        "bridge.virtualRegex.replacement"
      ],
      "requiredActions": [
        "reset-virtual-regex",
        "test-virtual-regex"
      ]
    },
    {
      "id": "image",
      "label": "图像",
      "requiredPaths": [
        "bridge.imageApi.mode",
        "bridge.imageApi.externalAdapter",
        "bridge.imageApi.endpoint",
        "bridge.imageApi.apiKey",
        "bridge.imageApi.model",
        "bridge.imageApi.size",
        "bridge.imageApi.steps",
        "bridge.imageApi.sampler",
        "bridge.imageApi.requestTimeoutMs",
        "bridge.imageApi.pollIntervalMs",
        "bridge.imageApi.pollAttempts",
        "bridge.imageApi.promptPrefix"
      ],
      "requiredActions": [
        "fetch-image-models",
        "test-image"
      ]
    },
    {
      "id": "scene",
      "label": "场景",
      "requiredPaths": [
        "bridge.sceneAssets.enabled",
        "bridge.sceneAssets.promptRule"
      ],
      "requiredActions": [
        "reset-prompt-rule",
        "save-prompt-rule"
      ]
    },
    {
      "id": "reader",
      "label": "阅读器",
      "requiredPaths": [
        "readerMode",
        "readerSettings.fontSize",
        "readerSettings.dialogSkin",
        "readerSettings.optionFontSize",
        "readerSettings.dialogWidth",
        "readerSettings.dialogHeight",
        "readerSettings.glassOpacity",
        "readerSettings.imageCountOverride",
        "readerSettings.inputScale",
        "readerSettings.toolbarScale",
        "readerSettings.imgMode"
      ]
    }
  ],
  "sceneSettingsSubTabs": [
    {
      "id": "rules",
      "label": "规则"
    },
    {
      "id": "assets",
      "label": "素材"
    }
  ],
  "readerSubTabs": [
    {
      "id": "display",
      "label": "显示"
    },
    {
      "id": "options",
      "label": "选项"
    },
    {
      "id": "toolbar",
      "label": "工具栏"
    },
    {
      "id": "theme",
      "label": "主题"
    }
  ],
  "styleChecks": {
    "viewportLeft": "left:var(--igs-settings-vleft)",
    "viewportTop": "top:var(--igs-settings-vtop)",
    "viewportWidth": "width:var(--igs-settings-vw)",
    "viewportHeight": "height:var(--igs-settings-vh)",
    "shellWidth": "width:var(--igs-settings-width)",
    "headerHeight": "height:54px",
    "segmentedHeight": "height:40px",
    "switchHeight": "height:38px",
    "palettePaper": "--igs-settings-paper:#16181a",
    "dayPalette": "#igs-unified-settings[data-igs-settings-theme=\"day\"]{--igs-settings-paper:#f1f1ef;--igs-settings-panel:#f7f7f5;--igs-settings-surface:#fbfbfa;--igs-settings-field:#e8e8e5",
    "palettePanel": "--igs-settings-panel:#1f2225",
    "paletteField": "--igs-settings-field:#282c2f",
    "radiusShell": "--igs-settings-radius-shell:8px",
    "radiusControl": "--igs-settings-radius-control:6px",
    "radiusSmall": "--igs-settings-radius-small:4px",
    "flatShell": "border:0;border-radius:var(--igs-settings-radius-shell);box-shadow:none",
    "flatBackdrop": "backdrop-filter:none",
    "activeTab": ".igs-settings-tab.is-active{background:var(--igs-settings-accent);color:var(--igs-settings-paper);box-shadow:none",
    "mainTabsEqual": ".igs-settings-tabs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2px",
    "themeToggle": ".igs-settings-theme-toggle{width:32px;height:32px;position:relative;left:-4px;top:3px;display:inline-flex;align-items:center;justify-content:center;padding:0",
    "themeToggleIcon": ".igs-settings-theme-toggle svg{display:block;width:11px;height:11px",
    "sceneSettingsSubTabs": ".igs-scene-settings-subtabs{position:sticky;top:0;z-index:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))",
    "sceneSettingsSubTabActive": ".igs-scene-settings-subtab.is-active{background:var(--igs-settings-accent);color:var(--igs-settings-paper);box-shadow:none",
    "readerSubTabs": ".igs-reader-subtabs{position:sticky;top:0;z-index:2;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))",
    "readerSubTabActive": ".igs-reader-subtab.is-active{background:var(--igs-settings-accent);color:var(--igs-settings-paper);box-shadow:none",
    "segmentedDynamicSpacing": ".igs-segmented{--igs-segment-pad:clamp(0px,calc(2cqi - 5px),6px);--igs-segment-gap:clamp(0px,calc(1.5cqi - 4px),5px);--igs-segment-font:clamp(9px,calc(5px + 1.5cqi),12px);--igs-segment-icon:clamp(8px,calc(3px + 2cqi),15px);container-type:inline-size",
    "segmentedButtonBox": ".igs-segmented-btn{box-sizing:border-box;width:100%;height:32px;min-width:0;margin:0;padding:0 var(--igs-segment-pad)",
    "flatSegmentedIndicator": ".igs-segmented-indicator{display:none",
    "mobileMedia": "@media (max-width:640px)"
  }
}
